---
import { richTextResolver } from '@storyblok/richtext';
import { coerceToDoc } from '../../lib/richtext';

interface Props {
  document: unknown;
}

const { document } = Astro.props;
const html = document
  ? richTextResolver()
      .render(coerceToDoc(document) as never)
      // The resolver emits alt="undefined" for nodes without alt text (e.g. emoji
      // fallback images). Decorative images must not expose a literal "undefined".
      .replaceAll('alt="undefined"', 'alt=""')
  : '';
---

{html && <Fragment set:html={html} />}
