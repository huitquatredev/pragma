---
import RichText from './RichText.astro';
import { cleanRichText } from '../../lib/richtext';
import type { FormSection } from '../../lib/livrables';

interface Props {
  coursId: string;
  partieId: string;
  sections: FormSection[];
  initial?: Record<string, unknown>;
  /** Values from earlier cours, used by formulas that reference their fields. */
  baseValues?: Record<string, unknown>;
  showDelete?: boolean;
}

const {
  coursId,
  partieId,
  sections,
  initial = {},
  baseValues = {},
  showDelete = false,
} = Astro.props;
const formId = `livrable-form-${coursId}`;

function str(key: string): string {
  const v = initial[key];
  return typeof v === 'string' ? v : typeof v === 'number' ? String(v) : '';
}
---

<form
  id={formId}
  class="livrable-form"
  data-cours-id={coursId}
  data-partie-id={partieId}
  data-saved={JSON.stringify(initial)}
  data-base-values={JSON.stringify(baseValues)}>
  {
    sections.map((section) => (
      <fieldset class="livrable-section">
        {section.titre && <legend class="livrable-section-title">{section.titre}</legend>}
        {section.intro && (
          <div class="rich-text livrable-intro">
            <RichText document={cleanRichText(section.intro)} />
          </div>
        )}
        {section.fields.map((field) => (
          <div class="livrable-field" data-field-key={field.key} data-field-kind={field.kind}>
            <label for={`${formId}-${field.key}`}>{field.label}</label>
            {field.aide && <p class="livrable-aide">{field.aide}</p>}
            {field.kind === 'text' && field.format === 'url' && (
              <input
                id={`${formId}-${field.key}`}
                name={field.key}
                type="url"
                inputmode="url"
                placeholder={field.placeholder ?? 'https://…'}
                value={str(field.key)}
              />
            )}
            {field.kind === 'text' && field.format !== 'url' && (
              // NOTE: keep the textarea EMPTY in markup (even Prettier-expanded):
              // any newline/indentation inside would become part of the value.
              // Initial values are set via JS below from `initial`.
              <textarea
                id={`${formId}-${field.key}`}
                name={field.key}
                rows="4"
                placeholder={field.placeholder ?? ''}
              />
            )}
            {field.kind === 'number' && field.min !== undefined && field.max !== undefined && (
              <div class="livrable-range">
                <div class="livrable-range-labels">
                  <span>
                    {field.minLabel ?? field.min}
                    {field.unite ? ` (${field.unite})` : ''}
                  </span>
                  <output id={`${formId}-${field.key}-val`}>
                    {str(field.key) || String(field.min)}
                  </output>
                  <span>
                    {field.maxLabel ?? field.max}
                    {field.unite ? ` (${field.unite})` : ''}
                  </span>
                </div>
                <input
                  id={`${formId}-${field.key}`}
                  name={field.key}
                  type="range"
                  min={field.min}
                  max={field.max}
                  step={field.entier === false ? 'any' : 1}
                  value={str(field.key) || String(field.min)}
                />
              </div>
            )}
            {field.kind === 'number' && (field.min === undefined || field.max === undefined) && (
              <div class="livrable-number">
                <input
                  id={`${formId}-${field.key}`}
                  name={field.key}
                  type="number"
                  inputmode="decimal"
                  step={field.entier === false ? 'any' : 1}
                  min={field.min}
                  max={field.max}
                  value={str(field.key)}
                />
                {field.unite && <span class="livrable-unite">{field.unite}</span>}
              </div>
            )}
            {field.kind === 'display' && (
              <p
                class="livrable-result"
                data-display-key={field.key}
                data-formula={field.formula ?? ''}>
                <span data-display-value>—</span>
                {field.unite && <span class="livrable-unite"> {field.unite}</span>}
              </p>
            )}
            {field.kind === 'image' && (
              <>
                {str(field.key) && (
                  <p>
                    <img
                      src={str(field.key)}
                      alt={`Capture — ${field.label}`}
                      class="livrable-preview"
                      loading="lazy"
                    />
                  </p>
                )}
                <input type="hidden" name={field.key} value={str(field.key)} />
                <input
                  id={`${formId}-${field.key}`}
                  type="file"
                  accept="image/jpeg,image/png,image/webp"
                  data-image-input={field.key}
                />
                <p class="livrable-aide">JPEG, PNG ou WebP — 5 Mo max.</p>
              </>
            )}
          </div>
        ))}
      </fieldset>
    ))
  }
  <div class="livrable-actions">
    <button type="submit" class="button">Enregistrer</button>
    {
      showDelete && (
        <button type="button" class="button button--text" data-delete>
          Supprimer mes réponses
        </button>
      )
    }
    <p class="livrable-status" role="status" aria-live="polite"></p>
  </div>
</form>

{
  /*
  Interactivity lives in src/scripts/livrable-forms.ts (bundled once via
  AppLayout). No `define:vars` script here: those are inlined raw by Astro
  and must stay import-free — per-instance data comes from data-attrs.
*/
}
