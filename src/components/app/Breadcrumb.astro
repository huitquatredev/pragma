---
interface Crumb {
  label: string;
  href?: string;
  level?: string;
  number?: number | null;
}

interface Props {
  items: Crumb[];
}

const { items } = Astro.props;
---

<nav class="breadcrumb" aria-label="Fil d'Ariane">
  <a href="/dashboard">Dashboard</a>
  {
    items.map((item) => {
      const display =
        item.number != null && item.level ? `${item.level} ${item.number}` : item.label;
      return (
        <>
          <span class="breadcrumb-sep">/</span>
          {item.href ? <a href={item.href}>{display}</a> : <span>{display}</span>}
        </>
      );
    })
  }
</nav>

<style>
  .breadcrumb {
    font: 700 0.75rem/1.4 var(--pg-font);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--pg-muted);
    margin-bottom: 2rem;
  }
  .breadcrumb a {
    color: inherit;
    text-decoration: none;
  }
  .breadcrumb a:hover {
    text-decoration: underline;
  }
  .breadcrumb-sep {
    margin: 0 0.4em;
    opacity: 0.5;
  }
</style>
