---
interface Props {
  direction: 'left' | 'right';
}

const { direction } = Astro.props;
---

<svg
  class="carousel-arrow"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true">
  {direction === 'left' ? <path d="M19 12H5M11 6l-6 6 6 6" /> : <path d="M5 12h14M13 6l6 6-6 6" />}
</svg>
