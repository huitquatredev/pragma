---
import { storyblokEditable } from '@storyblok/astro';
import { linkHref } from '../../lib/vitrine';

interface Props {
  blok: any;
}

const { blok } = Astro.props;
const parts = blok.parts ?? [];
---

<section
  class="mk-section"
  id={blok.anchor || undefined}
  {...storyblokEditable(blok)}
  aria-labelledby={`${blok.anchor || 'parts'}-title`}>
  <div class="programme-layout">
    <div class="programme-intro">
      {blok.eyebrow && <p class="eyebrow">{blok.eyebrow}</p>}
      <h2 id={`${blok.anchor || 'parts'}-title`}>{blok.title}</h2>
      {blok.intro && <p class="mk-lede">{blok.intro}</p>}
      {
        blok.cta_label && (
          <a class="button button--ghost" href={linkHref(blok.cta_link)}>
            {blok.cta_label}
          </a>
        )
      }
    </div>

    <ol class="parts">
      {
        parts.map((part: any, index: number) => (
          <li class="part" {...storyblokEditable(part)}>
            <span class="part__num">Partie {String(index + 1).padStart(2, '0')}</span>
            <h3>{part.title}</h3>
            <p>{part.text}</p>
            {part.deliverable && (
              <p class="part__deliverable">
                <span>Livrable</span>
                {part.deliverable}
              </p>
            )}
          </li>
        ))
      }
    </ol>
  </div>
</section>
