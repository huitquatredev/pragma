---
import RichText from '../app/RichText.astro';
import { cleanRichText } from '../../lib/richtext';

interface Props {
  blok: {
    titre?: string;
    consignes?: unknown;
  };
}

const { blok } = Astro.props;
---
<div class="section-text bloc-action">
  <h2>{blok.titre || 'À toi de jouer'}</h2>
  {blok.consignes && (
    <div class="rich-text">
      <RichText document={cleanRichText(blok.consignes)} />
    </div>
  )}
</div>
