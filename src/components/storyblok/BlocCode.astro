---
interface Props {
  blok: {
    titre?: string;
    langage?: string;
    note?: string;
    code?: string;
  };
}

const { blok } = Astro.props;
const label = (blok.langage ?? '').trim() || 'text';
const code = (blok.code ?? '').replace(/\r\n/g, '\n').trim();
const uid = Math.random().toString(36).slice(2, 10);
---

{
  code && (
    <div class="section-text bloc-code">
      {blok.titre && <h2>{blok.titre}</h2>}
      {blok.note && <p class="bloc-code-note">{blok.note}</p>}
      <div class="bloc-code-shell" data-code-shell>
        <div class="bloc-code-head">
          <span class="bloc-code-lang">{label}</span>
          <button
            type="button"
            class="bloc-code-copy"
            data-code-copy={uid}
            aria-label="Copier le contenu">
            Copier
          </button>
        </div>
        <pre class="bloc-code-pre">
          <code id={`bloc-code-${uid}`}>{code}</code>
        </pre>
      </div>
    </div>
  )
}

<script>
  (() => {
    const COPY_LABEL = 'Copier';
    const DONE_LABEL = 'Copié';

    function copyText(text: string): Promise<void> {
      if (navigator.clipboard?.writeText) return navigator.clipboard.writeText(text);
      return new Promise((resolve, reject) => {
        const area = document.createElement('textarea');
        area.value = text;
        area.setAttribute('readonly', '');
        area.style.position = 'fixed';
        area.style.opacity = '0';
        document.body.appendChild(area);
        area.select();
        try {
          document.execCommand('copy') ? resolve() : reject();
        } catch {
          reject();
        } finally {
          document.body.removeChild(area);
        }
      });
    }

    document.addEventListener('click', async (event) => {
      const btn = (event.target as HTMLElement)?.closest?.('[data-code-copy]');
      if (!(btn instanceof HTMLButtonElement)) return;
      const target = document.getElementById(`bloc-code-${btn.dataset.codeCopy}`);
      if (!target) return;
      try {
        await copyText(target.textContent ?? '');
        btn.textContent = DONE_LABEL;
        btn.dataset.state = 'ok';
      } catch {
        btn.textContent = 'Échec';
        btn.dataset.state = 'ko';
      }
      window.setTimeout(() => {
        btn.textContent = COPY_LABEL;
        delete btn.dataset.state;
      }, 1800);
    });
  })();
</script>

<style>
  .bloc-code-note {
    margin: 0 0 1rem;
    max-width: 45rem;
    font-size: 1.05rem;
    line-height: 1.6;
    color: var(--pg-muted);
  }

  .bloc-code-shell {
    border: 1px solid var(--pg-line);
    border-radius: var(--pg-radius-sm);
    background: var(--pg-navy-deep);
    overflow: hidden;
  }

  .bloc-code-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.55rem 0.9rem;
    background: rgb(255 255 255 / 0.06);
    border-bottom: 1px solid rgb(255 255 255 / 0.1);
  }

  .bloc-code-lang {
    font-family: ui-monospace, monospace;
    font-size: 0.72rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: rgb(255 255 255 / 0.55);
  }

  .bloc-code-copy {
    appearance: none;
    border: 1px solid rgb(255 255 255 / 0.25);
    background: transparent;
    color: #fff;
    font: inherit;
    font-size: 0.8rem;
    font-weight: 700;
    padding: 0.3rem 0.7rem;
    border-radius: 999px;
    cursor: pointer;
    transition:
      background 0.15s ease,
      border-color 0.15s ease;
  }

  .bloc-code-copy:hover {
    background: rgb(255 255 255 / 0.12);
  }

  .bloc-code-copy[data-state='ok'] {
    border-color: var(--pg-orange);
    background: var(--pg-orange);
    color: var(--pg-navy-deep);
  }

  .bloc-code-copy[data-state='ko'] {
    border-color: #ff6b6b;
    color: #ff6b6b;
  }

  .bloc-code-pre {
    margin: 0;
    padding: 1.1rem 1.2rem 1.3rem;
    max-height: 22rem;
    overflow: auto;
    overscroll-behavior: contain;
    font-family: ui-monospace, monospace;
    font-size: 0.86rem;
    line-height: 1.6;
    color: rgb(255 255 255 / 0.92);
    tab-size: 2;
    white-space: pre-wrap;
    word-break: break-word;
  }

  .bloc-code-pre code {
    font: inherit;
    background: none;
    padding: 0;
    color: inherit;
  }

  @media (max-width: 640px) {
    .bloc-code-pre {
      max-height: 18rem;
      font-size: 0.8rem;
      padding: 0.9rem;
    }
  }
</style>
