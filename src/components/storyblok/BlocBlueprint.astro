---
import { storyblokEditable } from '@storyblok/astro';

interface Props {
  blok: {
    code?: string;
  };
}

const { blok } = Astro.props;
---

<div {...storyblokEditable(blok)} class="bloc-blueprint">
  {blok.code && <Fragment set:html={blok.code} />}
</div>

<style>
  .bloc-blueprint {
    width: 100%;
    overflow-x: auto;
    margin: 2rem 0;
  }
  .bloc-blueprint :global(.blueprint-container) {
    max-width: 100% !important;
    box-sizing: border-box;
  }
</style>

