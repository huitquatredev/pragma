---
export const prerender = true;
import Layout from '../layouts/Layout.astro';
---

<Layout
  seo={{
    title: 'Pragma Formation',
    description:
      'La méthode concrète pour transformer ton idée en activité freelance rentable et sécurisée.',
  }}>
  <div class="marketing-shell">
    <header class="marketing-nav">
      <a href="/" class="wordmark" aria-label="Pragma Formation">pragma</a><a
        class="button"
        href="/login">Accéder à la plateforme</a
      >
    </header>
    <section class="hero">
      <p class="eyebrow">Formation — Freelance</p><h1>
        La méthode concrète pour transformer ton idée en <span class="accent"
          >activité freelance rentable</span
        > et sécurisée.
      </h1><p class="hero-copy">
        Spécialement conçue pour les salariés et fonctionnaires qui lancent leur side-project.
      </p><a class="button button--accent" href="/login">Commencer mon parcours</a>
      <img
        src="https://images.unsplash.com/photo-1487958449943-2429e8be8625?auto=format&fit=crop&w=1600&q=85"
        alt="Architecture abstraite en lumière et béton"
      />
      <p class="hero-band">
        De l'étude de marché à la signature de tes premiers clients. Programme détaillé pas à pas.
      </p>
      <div class="hero-cards">
        <div class="hero-card">
          <h3>À ton rythme</h3><p>Des cours à lire le soir ou le week-end, sans horaire imposé.</p>
        </div><div class="hero-card">
          <h3>Jamais seul·e</h3><p>Entraide sur Discord + lives collectifs avec replay.</p>
        </div><div class="hero-card">
          <h3>Accès 18 mois</h3><p>Progresse sans stress, à côté de ton emploi.</p>
        </div>
      </div>
    </section>
    <section class="marketing-grid" id="presentation">
      <p class="eyebrow">La méthode</p><div>
        <h2>Une formation pensée comme une architecture.</h2><p>
          Chaque partie assemble des modules courts et des cours actionnables, avec un livrable
          vérifiable à la fin. Tu avances à ton rythme, avec une progression visible.
        </p>
      </div>
    </section>
    <section id="offre" class="offer">
      <p class="eyebrow">L’offre</p><h2>Un cadre clair pour aller plus loin.</h2>
      <div class="offer-grid">
        <article>
          <span>01</span><h3>Comprendre</h3><p>Les concepts essentiels, expliqués sans détour.</p>
        </article><article>
          <span>02</span><h3>Pratiquer</h3><p>
            Des exercices et livrables pour transformer les idées en gestes.
          </p>
        </article><article>
          <span>03</span><h3>Progresser</h3><p>Un parcours mesurable, construit pour durer.</p>
        </article>
      </div>
    </section>
    <section id="contact" class="contact">
      <p class="eyebrow">Contact</p><h2>Construisons la suite.</h2><a
        class="button"
        href="mailto:bonjour@pragma-formation.fr">bonjour@pragma-formation.fr</a
      >
    </section>
  </div>
</Layout>
