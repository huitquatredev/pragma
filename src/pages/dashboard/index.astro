---
import AppLayout from '../../layouts/AppLayout.astro';
import LockIcon from '../../components/app/LockIcon.astro';
import ProgressIndex from '../../components/app/ProgressIndex.astro';
import { fetchFormationIndex } from '../../lib/storyblok';
import { stripLevelPrefix, oneBased } from '../../lib/titres';
import { previewInscription } from '../../lib/supabase';
import {
  countAccessible,
  flattenCourses,
  getFirstIncompleteCourse,
  getPartStatus,
  getProgressIndex,
} from '../../lib/progress';

const isPreview = process.env.IS_PREVIEW === 'true' || import.meta.env.IS_PREVIEW === 'true';
const inscription = isPreview ? previewInscription : Astro.locals.inscription;
const displayName =
  inscription?.first_name || inscription?.last_name
    ? [inscription.first_name, inscription.last_name].filter(Boolean).join(' ')
    : (Astro.locals.user?.email ?? '');
const parts = await fetchFormationIndex();

let validatedIds = new Set<string>();
if (!isPreview && Astro.locals.supabase) {
  try {
    const { data: rows } = await Astro.locals.supabase
      .from('progress')
      .select('cours_id, validated_at')
      .eq('user_id', Astro.locals.user?.id);
    validatedIds = getProgressIndex(rows ?? []);
  } catch {
    validatedIds = new Set();
  }
}

const nextCourse = inscription ? getFirstIncompleteCourse(parts, validatedIds, inscription) : null;
const nextCourseTitle = nextCourse ? stripLevelPrefix(nextCourse.content.title) : '';
// Partie courante : la première avec au moins un cours accessible non validé
// (les parties entièrement verrouillées sont sautées, mais restent visitables).
let currentPart = 0;
if (inscription && parts.length > 0) {
  const found = parts.findIndex((part) =>
    flattenCourses([part], inscription).some((c) => !validatedIds.has(c.uuid))
  );
  currentPart = found >= 0 ? found : parts.length - 1;
}
const accessibleCourses = inscription ? flattenCourses(parts, inscription) : [];
const validatedCount = accessibleCourses.filter((c) => validatedIds.has(c.uuid)).length;
const overall =
  accessibleCourses.length > 0 ? Math.round((validatedCount / accessibleCourses.length) * 100) : 0;

let submissions = new Map<string, string>();
if (!isPreview && Astro.locals.supabase && Astro.locals.user) {
  try {
    const { data } = await Astro.locals.supabase
      .from('livrable_submissions')
      .select('partie_id, submitted_at')
      .eq('user_id', Astro.locals.user.id);
    submissions = new Map(
      ((data ?? []) as { partie_id: string; submitted_at: string }[]).map((s) => [
        s.partie_id,
        s.submitted_at,
      ])
    );
  } catch {
    submissions = new Map();
  }
}
const submittedCount = parts.filter((p) => submissions.has(p.uuid)).length;

function partCoursUuids(part: (typeof parts)[number]) {
  return [
    ...(part.content.modules ?? []).flatMap((m) =>
      m && typeof m === 'object' && m.content ? (m.content.cours ?? []) : []
    ),
    ...(part.content.cours ?? []),
  ];
}
function isPartLocked(part: (typeof parts)[number]): boolean {
  if (!inscription) return false;
  const access = countAccessible(partCoursUuids(part), inscription);
  return access.total > 0 && access.accessible === 0;
}
// Livrable courant : premier non envoyé (les verrouillés sont sautés sauf
// s'il ne reste qu'eux) ; tout envoyé -> le dernier.
let currentLivrable = 0;
if (parts.length > 0) {
  const open = parts.findIndex((p) => !submissions.has(p.uuid) && !isPartLocked(p));
  if (open >= 0) currentLivrable = open;
  else {
    const anyOpen = parts.findIndex((p) => !submissions.has(p.uuid));
    currentLivrable = anyOpen >= 0 ? anyOpen : parts.length - 1;
  }
}
---

<AppLayout title="Dashboard — Pragma Formation">
  <main class="app-shell">
    <div class="page-heading">
      <p class="eyebrow">ESPACE PERSONNEL</p><h1>
        Bonjour{displayName ? `, ${displayName}` : ''}.
      </h1><p>Votre parcours, en un regard.</p>
    </div>
    {
      nextCourse ? (
        <section class="dash-resume" aria-label="Reprendre">
          <div>
            <p class="eyebrow eyebrow--light">À reprendre</p>
            <p class="dash-resume-title">{nextCourseTitle}</p>
          </div>
          <a class="button button--accent" href={`/cours/${nextCourse.slug}`}>
            Continuer le cours
          </a>
        </section>
      ) : (
        overall === 100 &&
        accessibleCourses.length > 0 && (
          <section class="dash-resume" aria-label="Parcours terminé">
            <div>
              <p class="eyebrow eyebrow--light">Parcours terminé</p>
              <p class="dash-resume-title">Tous les cours sont validés, bravo.</p>
            </div>
          </section>
        )
      )
    }
    <section class="dash-stats" aria-label="Chiffres clés">
      <div class="stat-card">
        <p class="stat-num">{overall}%</p>
        <p class="stat-label">Progression globale</p>
        <div class="progress-bar" aria-hidden="true">
          <span style={`width: ${overall}%`}></span>
        </div>
      </div>
      <div class="stat-card">
        <p class="stat-num">
          {validatedCount}<span class="stat-total">/{accessibleCourses.length}</span>
        </p>
        <p class="stat-label">Cours validés</p>
      </div>
      <div class="stat-card">
        <p class="stat-num">
          {submittedCount}<span class="stat-total">/{parts.length}</span>
        </p>
        <p class="stat-label">Livrables envoyés</p>
      </div>
    </section>
    <section aria-label="Ma formation">
      {
        inscription && (
          <ProgressIndex
            parts={parts}
            validatedIds={validatedIds}
            inscription={inscription}
            current={currentPart}
            title="Ma formation"
          />
        )
      }
    </section>
    <section aria-label="Mes livrables" class="livrables-full">
      <div class="parties-carousel" data-carousel>
        <div class="section-head">
          <h2 class="dash-section-title">Mes livrables</h2>
          {
            parts.length > 1 && (
              <div class="carousel-nav">
                <button
                  type="button"
                  class="carousel-btn"
                  data-prev
                  aria-label="Livrable précédent">
                  ←
                </button>
                <div class="carousel-dots" role="tablist" aria-label="Choisir un livrable">
                  {parts.map((part, partIndex) => (
                    <button
                      type="button"
                      class="carousel-dot"
                      data-dot={partIndex}
                      role="tab"
                      aria-selected={partIndex === currentLivrable ? 'true' : 'false'}
                      aria-label={`Livrable ${oneBased(partIndex)} : ${stripLevelPrefix(part.content.title)}`}
                    />
                  ))}
                </div>
                <p
                  class="carousel-counter"
                  data-counter
                  data-counter-label="Livrable"
                  aria-live="polite">
                  Livrable {currentLivrable + 1} / {parts.length}
                </p>
                <button type="button" class="carousel-btn" data-next aria-label="Livrable suivant">
                  →
                </button>
              </div>
            )
          }
        </div>
        <p class="dash-section-intro">
          Un livrable par partie : retrouvez, modifiez et envoyez vos données.
        </p>
        {
          parts.map((part, partIndex) => {
            const status = inscription ? getPartStatus(part, validatedIds, inscription) : null;
            const submittedAt = submissions.get(part.uuid);
            const locked = isPartLocked(part);
            return (
              <div data-slide hidden={partIndex !== currentLivrable}>
                <ul class="content-list">
                  <li class={locked ? 'is-locked' : undefined}>
                    {locked ? (
                      <span class="locked-row">
                        <span>
                          <span class="progress-index-level">Partie {oneBased(partIndex)}</span>
                          <LockIcon />
                          {stripLevelPrefix(part.content.title)}
                        </span>
                        <span class="pill">Verrouillé</span>
                      </span>
                    ) : (
                      <a href={`/dashboard/livrables/${part.slug}`}>
                        <span>
                          <span class="progress-index-level">Partie {oneBased(partIndex)}</span>
                          {stripLevelPrefix(part.content.title)}
                          <span class="livrables-meta">
                            {status ? `${status.percentage}% du parcours` : ''}
                            {status && submittedAt ? ' • ' : ''}
                            {submittedAt
                              ? `Envoyé le ${new Date(submittedAt).toLocaleDateString('fr-FR')}`
                              : ''}
                          </span>
                        </span>
                        <span class="livrables-side">
                          {submittedAt ? (
                            <span class="pill pill--solid">Envoyé</span>
                          ) : (
                            <span class="pill">À compléter</span>
                          )}
                          <span aria-hidden="true">→</span>
                        </span>
                      </a>
                    )}
                  </li>
                </ul>
              </div>
            );
          })
        }
      </div>
    </section>
  </main>
</AppLayout>
