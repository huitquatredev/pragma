---
import AppLayout from '../../layouts/AppLayout.astro';
import ProgressIndex from '../../components/app/ProgressIndex.astro';
import { fetchFormationIndex } from '../../lib/storyblok';
import { previewInscription } from '../../lib/supabase';
import { getFirstIncompleteCourse, getProgressIndex } from '../../lib/progress';

const isPreview = process.env.IS_PREVIEW === 'true' || import.meta.env.IS_PREVIEW === 'true';
const inscription = isPreview ? previewInscription : Astro.locals.inscription;
const displayName =
  inscription?.first_name || inscription?.last_name
    ? [inscription.first_name, inscription.last_name].filter(Boolean).join(' ')
    : (Astro.locals.user?.email ?? '');
const parts = await fetchFormationIndex();

let validatedIds = new Set<string>();
if (!isPreview && Astro.locals.supabase) {
  try {
    const { data: rows } = await Astro.locals.supabase
      .from('progress')
      .select('cours_id, validated_at')
      .eq('user_id', Astro.locals.user?.id);
    validatedIds = getProgressIndex(rows ?? []);
  } catch {
    validatedIds = new Set();
  }
}

const nextCourse = inscription ? getFirstIncompleteCourse(parts, validatedIds, inscription) : null;
---

<AppLayout title="Dashboard — Pragma Formation">
  <main class="app-shell">
    <div class="page-heading">
      <p class="eyebrow">ESPACE PERSONNEL</p><h1>
        Bonjour{displayName ? `, ${displayName}` : ''}.
      </h1><p>Votre parcours, en un regard.</p>
    </div>
    {
      nextCourse && (
        <div class="dashboard-meta">
          <a class="button button--accent" href={`/cours/${nextCourse.slug}`}>
            Aller au prochain cours non validé
          </a>
        </div>
      )
    }
    {inscription && <ProgressIndex {parts} {validatedIds} {inscription} />}
    <section aria-label="Mes livrables" class="livrables-index">
      <h2>Mes livrables</h2>
      <p>Un livrable par partie : retrouvez, modifiez et envoyez vos données.</p>
      <ul class="content-list">
        {
          parts.map((part) => (
            <li>
              <a href={`/dashboard/livrables/${part.slug}`}>
                <span>{part.content.title}</span>
                <span aria-hidden="true">→</span>
              </a>
            </li>
          ))
        }
      </ul>
    </section>
  </main>
</AppLayout>
