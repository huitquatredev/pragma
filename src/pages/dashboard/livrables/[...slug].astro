---
import AppLayout from '../../../layouts/AppLayout.astro';
import Breadcrumb from '../../../components/app/Breadcrumb.astro';
import CoursForm from '../../../components/app/CoursForm.astro';
import { fetchStory, type StoryblokStory } from '../../../lib/storyblok';
import { previewInscription } from '../../../lib/supabase';
import {
  getCoursForm,
  inputFields,
  livrableMissingCount,
  type AnswersByCours,
  type FormSection,
} from '../../../lib/livrables';

const isPreview = process.env.IS_PREVIEW === 'true' || import.meta.env.IS_PREVIEW === 'true';
const slug = Astro.params.slug!;
const story = await fetchStory(`parties/${slug}`).catch(() => null);
if (!story) {
  return new Response(null, { status: 404, statusText: 'Not found' });
}
const inscription = isPreview ? previewInscription : Astro.locals.inscription;

interface CoursFormData {
  uuid: string;
  slug: string;
  title: string;
  sections: FormSection[];
}

let forms: CoursFormData[] = [];
{
  // Form definitions are public CMS content: always load (including preview
  // mode, so editors and local dev see the forms). Only answers differ.
  const refs: StoryblokStory[] = [
    ...(story.content.modules ?? []).flatMap((m) => m.content?.cours ?? []),
    ...(story.content.cours ?? []),
  ].filter((c) => c && typeof c === 'object' && c.uuid && c.content !== null);
  // Sequential fetches: a Promise.all burst can hit Storybok CDN rate limits.
  const stories: (StoryblokStory | null)[] = [];
  for (const ref of refs) {
    try {
      stories.push(await fetchStory(ref.full_slug || `cours/${ref.slug}`));
    } catch {
      stories.push(null);
    }
  }
  forms = (stories.filter(Boolean) as StoryblokStory[])
    .map((s) => ({
      uuid: s.uuid,
      slug: s.slug,
      title: s.content.title ?? s.slug,
      sections: getCoursForm(s),
    }))
    .filter((f) => f.sections.some((sec) => sec.fields.length > 0));
}

let answers: AnswersByCours = {};
let submission: { submitted_at: string } | null = null;
if (!isPreview && Astro.locals.supabase && Astro.locals.user && forms.length > 0) {
  try {
    const { data: rows } = await Astro.locals.supabase
      .from('form_answers')
      .select('cours_id, payload')
      .eq('user_id', Astro.locals.user.id)
      .in(
        'cours_id',
        forms.map((f) => f.uuid)
      );
    for (const row of (rows as { cours_id: string; payload: Record<string, unknown> }[]) ?? []) {
      answers[row.cours_id] = row.payload ?? {};
    }
    const { data: sub } = await Astro.locals.supabase
      .from('livrable_submissions')
      .select('submitted_at')
      .eq('user_id', Astro.locals.user.id)
      .eq('partie_id', story.uuid)
      .maybeSingle();
    submission = (sub as { submitted_at: string } | null) ?? null;
  } catch {
    answers = {};
  }
}

const formsByCours: Record<string, FormSection[]> = Object.fromEntries(
  forms.map((f) => [f.uuid, f.sections])
);
const { missing, total } = livrableMissingCount(formsByCours, answers);
// Required INPUT keys per cours (displays are computed, never required).
const requiredByCours: Record<string, string[]> = Object.fromEntries(
  forms.map((f) => [f.uuid, inputFields(f.sections).map((field) => field.key)])
);
const submittedLabel = submission ? new Date(submission.submitted_at).toLocaleString('fr-FR') : '';
const hasAccess = Boolean(inscription?.correction);
const canSubmit = !isPreview && hasAccess && total > 0 && missing === 0;
const submitReason = isPreview
  ? 'Aperçu : connectez-vous pour envoyer.'
  : !hasAccess
    ? 'Votre accès ne comprend pas la correction.'
    : total === 0
      ? 'Aucun formulaire dans cette partie pour le moment.'
      : missing > 0
        ? `Complétez les ${missing} champ${missing > 1 ? 's' : ''} restant${missing > 1 ? 's' : ''} (${total - missing}/${total} remplis).`
        : submission
          ? `Envoyé le ${new Date(submission.submitted_at).toLocaleString('fr-FR')} — vous pouvez modifier puis renvoyer.`
          : 'Livrable complet — vous pouvez l’envoyer.';
---

<AppLayout title={`Livrable — ${story.content.title} — Pragma Formation`}>
  <main class="content-shell">
    <p class="eyebrow">LIVRABLE</p>
    <h1>{story.content.title}</h1>
    <Breadcrumb items={[{ label: story.content.title }]} />
    {
      submission && (
        <p class="livrable-submitted">
          Dernier envoi : {new Date(submission.submitted_at).toLocaleString('fr-FR')}
        </p>
      )
    }
    {
      forms.length === 0 && (
        <p>Aucun formulaire « À toi de jouer » dans cette partie pour le moment.</p>
      )
    }
    {
      forms.map((form) => (
        <section class="livrable-cours" aria-label={form.title}>
          <h2>
            <a href={`/cours/${form.slug}`}>{form.title}</a>
          </h2>
          <CoursForm
            coursId={form.uuid}
            partieId={story.uuid}
            sections={form.sections}
            initial={answers[form.uuid] ?? {}}
            showDelete
          />
        </section>
      ))
    }
    {
      forms.length > 0 && (
        <form
          id="livrable-submit"
          class="livrable-submit"
          data-partie-slug={story.slug}
          data-has-access={hasAccess ? 'true' : 'false'}
          data-submitted-label={submittedLabel}
          data-required={JSON.stringify(requiredByCours)}>
          <p class="livrable-status" role="status" aria-live="polite">
            {submitReason}
          </p>
          <button type="submit" class="button button--accent" disabled={!canSubmit}>
            Envoyer pour relecture
          </button>
          {!hasAccess && <p class="livrable-aide">Bouton désactivé : accès correction requis.</p>}
          {hasAccess && (
            <p class="livrable-aide" data-incomplete-hint hidden={missing === 0}>
              Bouton désactivé : tous les champs sont requis.
            </p>
          )}
        </form>
      )
    }
  </main>
</AppLayout>

<script>
  import { evaluateDisplays } from '../../../lib/livrables';
  const submitForm = document.getElementById('livrable-submit');
  if (submitForm) {
    const statusEl = submitForm.querySelector('.livrable-status');
    const submitButton = submitForm.querySelector('button[type="submit"]');
    const incompleteHint = submitForm.querySelector('[data-incomplete-hint]');
    const hasAccess = submitForm.dataset.hasAccess === 'true';
    const submittedLabel = submitForm.dataset.submittedLabel || '';
    let required = {};
    try {
      required = JSON.parse(submitForm.dataset.required || '{}');
    } catch {
      required = {};
    }
    const totalFields = Object.values(required).reduce((n, keys) => n + keys.length, 0);

    const coursScope = (coursId) =>
      document.querySelector(`form.livrable-form[data-cours-id="${CSS.escape(coursId)}"]`);

    const fieldValue = (coursId, key) => {
      const el = coursScope(coursId)?.querySelector(`[name="${CSS.escape(key)}"]`);
      return el ? String(el.value ?? '') : '';
    };

    const savedValue = (coursId, key) => {
      let saved = {};
      try {
        saved = JSON.parse(coursScope(coursId)?.dataset.saved || '{}');
      } catch {
        saved = {};
      }
      const value = saved[key];
      return typeof value === 'string' || typeof value === 'number' ? String(value) : '';
    };

    // Live check: enabled only when every field is filled AND saved
    // (server re-validates on submit — this is UX only).
    const refreshSubmitState = () => {
      if (!hasAccess || !submitButton || totalFields === 0) return;
      let missing = 0;
      let dirty = false;
      for (const [coursId, keys] of Object.entries(required)) {
        for (const key of keys) {
          const current = fieldValue(coursId, key).trim();
          if (current === '') missing += 1;
          if (current !== savedValue(coursId, key).trim()) dirty = true;
        }
      }
      const done = totalFields - missing;
      if (dirty) {
        submitButton.disabled = true;
        if (statusEl)
          statusEl.textContent =
            'Des modifications ne sont pas enregistrées — cliquez « Enregistrer » dans chaque cours modifié.';
        incompleteHint?.removeAttribute('hidden');
      } else if (missing === 0) {
        submitButton.disabled = false;
        if (statusEl)
          statusEl.textContent = submittedLabel
            ? `Envoyé le ${submittedLabel} — vous pouvez modifier puis renvoyer.`
            : 'Livrable complet — vous pouvez l’envoyer.';
        incompleteHint?.setAttribute('hidden', '');
      } else {
        submitButton.disabled = true;
        if (statusEl)
          statusEl.textContent = `Complétez les ${missing} champ${missing > 1 ? 's' : ''} restant${missing > 1 ? 's' : ''} (${done}/${totalFields} remplis).`;
        incompleteHint?.removeAttribute('hidden');
      }
    };

    // Recompute calculated results with values merged across ALL cours
    // of the partie (DOM order = partie order, later wins — same as server),
    // feeding computed displays back in for chained formulas.
    const refreshDisplays = () => {
      const merged = {};
      document.querySelectorAll('form.livrable-form').forEach((scope) => {
        scope.querySelectorAll('[name]').forEach((el) => {
          if (el.type === 'file') return;
          merged[el.getAttribute('name')] = el.value;
        });
      });
      const defs = [...document.querySelectorAll('[data-formula]')].map((el) => ({
        key: el.dataset.displayKey ?? '',
        formula: el.dataset.formula ?? '',
      }));
      const computed = evaluateDisplays(defs, merged);
      document.querySelectorAll('[data-formula]').forEach((el) => {
        const out = el.querySelector('[data-display-value]');
        if (out) out.textContent = computed[el.dataset.displayKey ?? ''] ?? '—';
      });
    };

    document.addEventListener('input', (e) => {
      if (e.target instanceof HTMLElement && e.target.closest('form.livrable-form')) {
        refreshSubmitState();
        refreshDisplays();
      }
    });
    document.addEventListener('change', (e) => {
      if (e.target instanceof HTMLElement && e.target.closest('form.livrable-form')) {
        refreshSubmitState();
        refreshDisplays();
      }
    });
    // Fired by each CoursForm after image upload, save and delete.
    window.addEventListener('livrable:update', () => {
      refreshSubmitState();
      refreshDisplays();
    });
    refreshSubmitState();
    refreshDisplays();

    submitForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (submitButton) submitButton.disabled = true;
      if (statusEl) statusEl.textContent = 'Envoi en cours…';
      try {
        const res = await fetch('/api/livrable_submit', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ partie_slug: submitForm.dataset.partieSlug }),
        });
        const json = await res.json().catch(() => ({}));
        if (!res.ok) throw new Error(json.error || 'Échec de l’envoi.');
        const dateEnvoyee = new Date(json.submitted_at).toLocaleString('fr-FR');
        const avertissement = json.email_sent
          ? ''
          : ' (' + (json.email_warning || 'email coach non configuré — voir logs') + ').';
        if (statusEl) statusEl.textContent = 'Envoyé le ' + dateEnvoyee + avertissement;
      } catch (err) {
        if (statusEl)
          statusEl.textContent = err instanceof Error ? err.message : 'Échec de l’envoi.';
        refreshSubmitState();
      }
    });
  }
</script>
