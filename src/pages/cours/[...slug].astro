---
import process from 'node:process';
import AppLayout from '../../layouts/AppLayout.astro';
import Breadcrumb from '../../components/app/Breadcrumb.astro';
import {
  fetchStory,
  fetchStoriesByComponent,
  type SectionText,
  type CoursBlok,
} from '../../lib/storyblok';
import { previewInscription } from '../../lib/supabase';
import {
  flattenCourses,
  getProgressIndex,
  hasCourseAccess,
  moduleCourses,
  partCourses,
} from '../../lib/progress';
import RichText from '../../components/app/RichText.astro';
import { cleanRichText, hasRichText } from '../../lib/richtext';
import BlocComprendre from '../../components/storyblok/BlocComprendre.astro';
import BlocQuiz from '../../components/storyblok/BlocQuiz.astro';
import BlocGuide from '../../components/storyblok/BlocGuide.astro';
import BlocAction from '../../components/storyblok/BlocAction.astro';
import BlocCode from '../../components/storyblok/BlocCode.astro';
import BlocBlueprint from '../../components/storyblok/BlocBlueprint.astro';
import BlocYoutube from '../../components/storyblok/BlocYoutube.astro';
import BlocHtml from '../../components/storyblok/BlocHtml.astro';
import { getCoursForm, hasForm } from '../../lib/livrables';
import { stripLevelPrefix, oneBased } from '../../lib/titres';

const isPreview = process.env.IS_PREVIEW === 'true' || import.meta.env.IS_PREVIEW === 'true';
const story = await fetchStory(`cours/${Astro.params.slug!}`).catch(() => null);
if (!story) {
  return new Response(null, { status: 404, statusText: 'Not found' });
}
const inscription = isPreview ? previewInscription : Astro.locals.inscription;

if (inscription && !hasCourseAccess(story, inscription)) {
  return new Response('Accès non autorisé.', { status: 403 });
}

let validatedIds = new Set<string>();
if (!isPreview && Astro.locals.supabase) {
  try {
    const { data: rows } = await Astro.locals.supabase
      .from('progress')
      .select('cours_id, validated_at')
      .eq('user_id', Astro.locals.user?.id);
    validatedIds = getProgressIndex(rows ?? []);
  } catch {
    validatedIds = new Set();
  }
}

const parts = await fetchStoriesByComponent('partie');
const courses = inscription ? flattenCourses(parts, inscription) : [];
const position = courses.findIndex((course) => course.uuid === story.uuid);
const previous = position > 0 ? courses[position - 1] : null;
const next = position >= 0 && position < courses.length - 1 ? courses[position + 1] : null;
const validated = validatedIds.has(story.uuid);

const parentPart = parts.find(
  (p) =>
    (p.content.modules ?? []).some((m) =>
      (m.content?.cours ?? []).some((c) => c.uuid === story.uuid)
    ) || (p.content.cours ?? []).some((c) => c.uuid === story.uuid)
);
const parentModule = parentPart
  ? (parentPart.content.modules ?? []).find((m) =>
      (m.content?.cours ?? []).some((c) => c.uuid === story.uuid)
    )
  : null;
const moduleIndex =
  parentPart && parentModule
    ? (parentPart.content.modules ?? []).findIndex((m) => m.uuid === parentModule.uuid)
    : -1;

const { fetchFormationIndex } = await import('../../lib/storyblok');
const allParts = await fetchFormationIndex();
const partNumber = oneBased(allParts.findIndex((p) => p.uuid === parentPart?.uuid));

type CourseNavTarget = { href: string; label: string };
let nextTarget: CourseNavTarget | null = null;

if (inscription && parentPart) {
  if (parentModule) {
    const moduleCourseList = moduleCourses(parentModule, inscription);
    const moduleCourseIndex = moduleCourseList.findIndex((course) => course.uuid === story.uuid);
    const nextModuleCourse =
      moduleCourseIndex >= 0 ? moduleCourseList[moduleCourseIndex + 1] : null;

    if (nextModuleCourse) {
      nextTarget = { href: `/cours/${nextModuleCourse.slug}`, label: 'Suivant →' };
    } else {
      const modules = (parentPart.content.modules ?? []).filter(
        (module) => module && typeof module === 'object' && module.content
      );
      const currentModuleIndex = modules.findIndex((module) => module.uuid === parentModule.uuid);
      const nextModule = modules
        .slice(currentModuleIndex + 1)
        .find((module) => moduleCourses(module, inscription).length > 0);

      if (nextModule) {
        nextTarget = { href: `/modules/${nextModule.slug}`, label: 'Module suivant →' };
      }
    }
  } else {
    const directCourses = (parentPart.content.cours ?? []).filter(
      (course) => course.content && hasCourseAccess(course, inscription)
    );
    const directIndex = directCourses.findIndex((course) => course.uuid === story.uuid);
    const nextDirectCourse = directIndex >= 0 ? directCourses[directIndex + 1] : null;

    if (nextDirectCourse) {
      nextTarget = { href: `/cours/${nextDirectCourse.slug}`, label: 'Suivant →' };
    }
  }

  if (!nextTarget) {
    const orderedParts = allParts.length > 0 ? allParts : parts;
    const currentPartIndex = orderedParts.findIndex((part) => part.uuid === parentPart.uuid);
    if (currentPartIndex >= 0) {
      const nextPart = orderedParts
        .slice(currentPartIndex + 1)
        .find((part) => partCourses(part, inscription).length > 0);
      if (nextPart) {
        nextTarget = { href: `/parties/${nextPart.slug}`, label: 'Partie suivante →' };
      }
    }
  }
}

if (!nextTarget && !parentPart && next) {
  nextTarget = { href: `/cours/${next.slug}`, label: 'Suivant →' };
}
const displayTitle = stripLevelPrefix(story.content.title);
const parentPartTitle = parentPart ? stripLevelPrefix(parentPart.content.title) : '';
const parentModuleTitle = parentModule ? stripLevelPrefix(parentModule.content.title) : '';

const competence = (story.content as { competence?: string }).competence;
const enjeuCours = (story.content as { enjeu?: unknown }).enjeu;

const coursSections = getCoursForm(story);
const coursHasForm = hasForm(coursSections);
const partieId = parentPart?.uuid ?? '';

let initialAnswers: Record<string, unknown> = {};
if (coursHasForm && !isPreview && Astro.locals.supabase && Astro.locals.user) {
  try {
    const { data } = await Astro.locals.supabase
      .from('form_answers')
      .select('payload')
      .eq('user_id', Astro.locals.user.id)
      .eq('cours_id', story.uuid)
      .maybeSingle();
    const payload = (data as { payload?: unknown } | null)?.payload;
    if (payload && typeof payload === 'object' && !Array.isArray(payload)) {
      initialAnswers = payload as Record<string, unknown>;
    }
  } catch {
    initialAnswers = {};
  }
}

const hasCompetence = typeof competence === 'string' && competence.trim().length > 0;
const cleanEnjeu = cleanRichText(enjeuCours);
---

<AppLayout title={`${displayTitle} — Pragma Formation`}>
  <main class="content-shell course-page">
    <p class="eyebrow">COURS</p><h1>{displayTitle}</h1>
    <Breadcrumb
      items={[
        ...(parentPart
          ? [
              {
                label: parentPartTitle,
                href: `/parties/${parentPart.slug}`,
                level: 'PARTIE',
                number: partNumber,
              },
            ]
          : []),
        ...(parentModule
          ? [
              {
                label: parentModuleTitle,
                href: `/modules/${parentModule.slug}`,
                level: 'MODULE',
                number: moduleIndex >= 0 ? moduleIndex + 1 : null,
              },
            ]
          : []),
        { label: displayTitle },
      ]}
    />
    {
      hasCompetence && (
        <div class="section-text">
          <h2>Compétence clé</h2>
          <div class="rich-text">
            <p>{competence}</p>
          </div>
        </div>
      )
    }
    {
      hasRichText(cleanEnjeu) && (
        <div class="section-text">
          <h2>Enjeu</h2>
          <div class="rich-text">
            <RichText document={cleanEnjeu} />
          </div>
        </div>
      )
    }
    {
      ((story.content.body as CoursBlok[]) ?? []).map((section) => {
        if (section.component === 'bloc_comprendre') return <BlocComprendre blok={section} />;
        if (section.component === 'bloc_quiz') return <BlocQuiz blok={section} />;
        if (section.component === 'bloc_guide') return <BlocGuide blok={section} />;
        if (section.component === 'bloc_code') return <BlocCode blok={section} />;
        if (section.component === 'bloc_blueprint') return <BlocBlueprint blok={section} />;
        if (section.component === 'bloc_youtube') return <BlocYoutube blok={section} />;
        if (section.component === 'html') return <BlocHtml blok={section} />;
        if (section.component === 'bloc_action')
          return (
            <BlocAction
              blok={section}
              coursId={story.uuid}
              partieId={partieId}
              initial={initialAnswers}
            />
          );
        const legacy = section as SectionText;
        return (
          <div class="section-text">
            {legacy.titre && <h2>{legacy.titre}</h2>}
            {legacy.corps && (
              <div class="rich-text">
                <RichText document={legacy.corps} />
              </div>
            )}
            {legacy.bouton_text && legacy.bouton_lien?.url && (
              <a class="button" href={legacy.bouton_lien.url}>
                {legacy.bouton_text}
              </a>
            )}
          </div>
        );
      })
    }
    <form method="post" action={`/cours/${story.slug}/progress`}>
      <input type="hidden" name="action" value={validated ? 'unvalidate' : 'validate'} /><button
        class="button"
        type="submit">{validated ? 'Annuler la validation' : 'Valider ce cours'}</button
      >
    </form>
    <nav class="course-nav" aria-label="Navigation des cours">
      {previous ? <a href={`/cours/${previous.slug}`}>← Précédent</a> : <span />}{
        nextTarget ? <a href={nextTarget.href}>{nextTarget.label}</a> : <span />
      }
    </nav>
  </main>
</AppLayout>
