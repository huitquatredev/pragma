---
import process from 'node:process';
import { useStoryblokApi } from '@storyblok/astro';
import StoryblokComponent from '@storyblok/astro/StoryblokComponent.astro';
import Layout from '../layouts/Layout.astro';
import VitrinePage from '../components/vitrine/VitrinePage.astro';
import type { StoryblokStory } from '../lib/storyblok';

const storyblokApi = useStoryblokApi();
const { slug } = Astro.params;
const isPreview = process.env.IS_PREVIEW === 'true' || import.meta.env.IS_PREVIEW === 'true';
const version = isPreview ? 'draft' : 'published';

const notFound = () => {
  Astro.response.status = 404;
  return Astro.rewrite('/404');
};

if (slug === 'home') {
  return Astro.redirect('/', 301);
}

if (slug === 'parties/index-general' || slug?.endsWith('/index-general')) {
  return notFound();
}

let story: StoryblokStory | undefined;
try {
  const { data } = await storyblokApi.get(`cdn/stories/${slug || 'home'}`, {
    version,
    token: import.meta.env.STORYBLOK_TOKEN,
  });
  story = data.story;
} catch {
  return notFound();
}

if (!story) return notFound();

const seo = {
  title: story.content?.title,
  description: story.content.description,
  robots: story.content.robots,
  schema: story.content.schema,
  ogImage: story.content.ogImage ? story.content.ogImage.filename : null,
  ogImageAlt: story.content.ogImageAlt
    ? story.content.ogImageAlt
    : story.content.ogImage?.alt
      ? story.content.ogImage.alt
      : ' ',
  canonical: story.content.canonical?.url,
};
---

{story.content.component === 'vitrine_page' && <VitrinePage story={story} />}
{
  story.content.component !== 'vitrine_page' && (
    <Layout {seo}>
      <StoryblokComponent blok={story.content as never} />
    </Layout>
  )
}
