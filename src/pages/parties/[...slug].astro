---
import AppLayout from '../../layouts/AppLayout.astro';
import ProgressBadge from '../../components/app/ProgressBadge.astro';
import RichText from '../../components/app/RichText.astro';
import { fetchStory, fetchFormationIndex, type SectionText } from '../../lib/storyblok';
import { createSupabaseServerClient } from '../../lib/supabase';
import { getModuleStatus, getProgressIndex } from '../../lib/progress';

const story = await fetchStory(Astro.params.slug!);
if (Astro.params.slug === 'index-general') {
  return new Response(null, { status: 404, statusText: 'Not found' });
}
const inscription = Astro.locals.inscription;
const supabase = createSupabaseServerClient(Astro);
const { data: rows } = await supabase
  .from('progress')
  .select('cours_id, validated_at')
  .eq('user_id', Astro.locals.user?.id);
const validatedIds = getProgressIndex(rows ?? []);

const parties = await fetchFormationIndex();
const partIndex = parties.findIndex((p) => p.uuid === story.uuid);
const partNumber = partIndex >= 0 ? partIndex : null;
---

<AppLayout title={`${story.content.title} — Pragma Formation`}>
  <main class="content-shell">
    <p class="eyebrow">PARTIE {partNumber != null ? `${partNumber}` : ''}</p><h1>{story.content.title}</h1>
    {(story.content.body as SectionText[] ?? []).map((section) => (
      <div class="section-text">
        {section.titre && <h2>{section.titre}</h2>}
        {section.corps && (
          <div class="rich-text">
            <RichText document={section.corps} />
          </div>
        )}
        {section.bouton_text && section.bouton_lien?.url && (
          <a class="button" href={section.bouton_lien.url}>{section.bouton_text}</a>
        )}
      </div>
    ))}
    <ul class="content-list">
      {
        inscription && (story.content.modules ?? []).map((module) => {
          const status = getModuleStatus(module, validatedIds, inscription);
          return (
            <li>
              <a href={`/modules/${module.slug}`}>
                <>
                  <span>{module.content.title}</span>
                  <span>
                    {status.percentage}% <ProgressBadge validated={status.validated} />
                  </span>
                </>
              </a>
            </li>
          );
        })
      }
    </ul>
  </main>
</AppLayout>
