---
import AppLayout from '../../layouts/AppLayout.astro';
import Breadcrumb from '../../components/app/Breadcrumb.astro';
import ProgressBadge from '../../components/app/ProgressBadge.astro';
import RichText from '../../components/app/RichText.astro';
import { cleanRichText } from '../../lib/richtext';
import BlocComprendre from '../../components/storyblok/BlocComprendre.astro';
import BlocQuiz from '../../components/storyblok/BlocQuiz.astro';
import BlocGuide from '../../components/storyblok/BlocGuide.astro';
import BlocAction from '../../components/storyblok/BlocAction.astro';
import { fetchStory, fetchFormationIndex, type CoursBlok, type SectionText } from '../../lib/storyblok';
import { previewInscription } from '../../lib/supabase';
import { getModuleStatus, getProgressIndex, hasCourseAccess } from '../../lib/progress';

const isPreview = process.env.IS_PREVIEW === 'true' || import.meta.env.IS_PREVIEW === 'true';
if (Astro.params.slug === 'index-general') {
  return new Response(null, { status: 404, statusText: 'Not found' });
}
const story = await fetchStory(`parties/${Astro.params.slug!}`).catch(
  () => null
);
if (!story) {
  return new Response(null, { status: 404, statusText: 'Not found' });
}
const inscription = isPreview ? previewInscription : Astro.locals.inscription;

let validatedIds = new Set<string>();
if (!isPreview && Astro.locals.supabase) {
  try {
    const { data: rows } = await Astro.locals.supabase
      .from('progress')
      .select('cours_id, validated_at')
      .eq('user_id', Astro.locals.user?.id);
    validatedIds = getProgressIndex(rows ?? []);
  } catch {
    validatedIds = new Set();
  }
}

const parties = await fetchFormationIndex();
const partIndex = parties.findIndex((p) => p.uuid === story.uuid);
const partNumber = partIndex >= 0 ? partIndex : null;

const enjeu = story.content.enjeu;
const objectifs = story.content.objectifs;
const livrables = story.content.livrables;
const directCours = story.content.cours ?? [];
const hasModules = (story.content.modules ?? []).length > 0;

function hasRichText(doc: unknown): boolean {
  if (!doc) return false;
  if (typeof doc === 'string') return doc.trim().length > 0;
  const node = doc as { content?: Array<{ content?: Array<{ text?: string }> }> };
  if (!Array.isArray(node.content)) return true;
  return node.content.some((block) =>
    (block.content ?? []).some((inline) => (inline.text ?? '').trim().length > 0)
  );
}

const hasContext = hasRichText(enjeu) || hasRichText(objectifs) || hasRichText(livrables);
---

<AppLayout title={`${story.content.title} — Pragma Formation`}>
  <main class="content-shell">
    <p class="eyebrow">PARTIE {partNumber != null ? `${partNumber}` : ''}</p><h1>
      {story.content.title}
    </h1>
    <Breadcrumb items={[{ label: story.content.title, level: 'PARTIE', number: partNumber }]} />
    {
      hasContext && (
        <section class="partie-context" aria-label="Contexte de la partie">
          {hasRichText(enjeu) && (
            <div class="partie-context-enjeu">
              <p class="eyebrow">Enjeu</p>
              <div class="rich-text partie-context-rich partie-context-rich--lede">
                <RichText document={cleanRichText(enjeu)} />
              </div>
            </div>
          )}
          {(hasRichText(objectifs) || hasRichText(livrables)) && (
            <div class="partie-context-grid">
              {hasRichText(objectifs) && (
                <div class="partie-context-block">
                  <p class="eyebrow">Objectifs</p>
                  <div class="rich-text partie-context-rich">
                    <RichText document={cleanRichText(objectifs)} />
                  </div>
                </div>
              )}
              {hasRichText(livrables) && (
                <div class="partie-context-block">
                  <p class="eyebrow">Livrables</p>
                  <div class="rich-text partie-context-rich">
                    <RichText document={cleanRichText(livrables)} />
                  </div>
                </div>
              )}
            </div>
          )}
        </section>
      )
    }
    {
      ((story.content.body as CoursBlok[]) ?? []).map((section) => {
        if (section.component === 'bloc_comprendre') return <BlocComprendre blok={section} />;
        if (section.component === 'bloc_quiz') return <BlocQuiz blok={section} />;
        if (section.component === 'bloc_guide') return <BlocGuide blok={section} />;
        if (section.component === 'bloc_action') return <BlocAction blok={section} />;
        const legacy = section as SectionText;
        return (
          <div class="section-text">
            {legacy.titre && <h2>{legacy.titre}</h2>}
            {legacy.corps && (
              <div class="rich-text">
                <RichText document={legacy.corps} />
              </div>
            )}
            {legacy.bouton_text && legacy.bouton_lien?.url && (
              <a class="button" href={legacy.bouton_lien.url}>
                {legacy.bouton_text}
              </a>
            )}
          </div>
        );
      })
    }
    {!hasModules && directCours.length > 0 && (
      <ul class="content-list">
        {directCours
          .filter((c) => c.content)
          .filter((c) => !inscription || hasCourseAccess(c, inscription))
          .map((course) => (
            <li>
              <a href={`/cours/${course.slug}`}>
                <>
                  <span>{course.content.title}</span>
                  <ProgressBadge validated={validatedIds.has(course.uuid)} />
                </>
              </a>
            </li>
          ))}
      </ul>
    )}
    <ul class="content-list">
      {
        inscription &&
          (story.content.modules ?? [])
            .filter((module) => module && typeof module === 'object' && module.content)
            .map((module, moduleIndex) => {
            const status = getModuleStatus(module, validatedIds, inscription);
            return (
              <li>
                <a href={`/modules/${module.slug}`}>
                  <>
                    <span>
                      MODULE {moduleIndex + 1} — {module.content.title}
                    </span>
                    <span>
                      {status.percentage}% <ProgressBadge validated={status.validated} />
                    </span>
                  </>
                </a>
              </li>
            );
          })
      }
    </ul>
  </main>
</AppLayout>
