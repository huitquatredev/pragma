---
import AppLayout from '../../layouts/AppLayout.astro';
import ProgressBadge from '../../components/app/ProgressBadge.astro';
import RichText from '../../components/app/RichText.astro';
import { fetchStory, type SectionText } from '../../lib/storyblok';
import { createSupabaseServerClient, previewInscription } from '../../lib/supabase';
import { getProgressIndex, hasCourseAccess } from '../../lib/progress';

const isPreview = process.env.IS_PREVIEW === 'true' || import.meta.env.IS_PREVIEW === 'true';
const story = await fetchStory(Astro.params.slug!);
const inscription = isPreview ? previewInscription : Astro.locals.inscription;

let validatedIds = new Set<string>();
if (!isPreview) {
  const supabase = createSupabaseServerClient(Astro);
  const { data: rows } = await supabase
    .from('progress')
    .select('cours_id, validated_at')
    .eq('user_id', Astro.locals.user?.id);
  validatedIds = getProgressIndex(rows ?? []);
}
---

<AppLayout title={`${story.content.title} — Pragma Formation`}>
  <main class="content-shell">
    <p class="eyebrow">MODULE</p><h1>{story.content.title}</h1>
    {(story.content.body as SectionText[] ?? []).map((section) => (
      <div class="section-text">
        {section.titre && <h2>{section.titre}</h2>}
        {section.corps && (
          <div class="rich-text">
            <RichText document={section.corps} />
          </div>
        )}
        {section.bouton_text && section.bouton_lien?.url && (
          <a class="button" href={section.bouton_lien.url}>{section.bouton_text}</a>
        )}
      </div>
    ))}
    <ul class="content-list">
      {
        (story.content.cours ?? [])
          .filter((c) => c.content)
          .filter((c) => !inscription || hasCourseAccess(c, inscription))
          .map((course) => (
            <li>
              <a href={`/cours/${course.slug}`}>
                <>
                  <span>{course.content.title}</span>
                  <ProgressBadge validated={validatedIds.has(course.uuid)} />
                </>
              </a>
            </li>
          ))
      }
    </ul>
  </main>
</AppLayout>
