---
import AppLayout from '../../layouts/AppLayout.astro';
import Breadcrumb from '../../components/app/Breadcrumb.astro';
import ProgressBadge from '../../components/app/ProgressBadge.astro';
import RichText from '../../components/app/RichText.astro';
import { cleanRichText, hasRichText } from '../../lib/richtext';
import { fetchStory, fetchStoriesByComponent, type SectionText } from '../../lib/storyblok';
import { previewInscription } from '../../lib/supabase';
import { getProgressIndex, hasCourseAccess } from '../../lib/progress';

const isPreview = process.env.IS_PREVIEW === 'true' || import.meta.env.IS_PREVIEW === 'true';
const story = await fetchStory(`modules/${Astro.params.slug!}`).catch(
  () => null
);
if (!story) {
  return new Response(null, { status: 404, statusText: 'Not found' });
}
const inscription = isPreview ? previewInscription : Astro.locals.inscription;

let validatedIds = new Set<string>();
if (!isPreview && Astro.locals.supabase) {
  try {
    const { data: rows } = await Astro.locals.supabase
      .from('progress')
      .select('cours_id, validated_at')
      .eq('user_id', Astro.locals.user?.id);
    validatedIds = getProgressIndex(rows ?? []);
  } catch {
    validatedIds = new Set();
  }
}

const parts = await fetchStoriesByComponent('partie');
const parentPart = parts.find((p) =>
  (p.content.modules ?? []).some((m) => typeof m === 'object' && m?.uuid === story.uuid)
);
const moduleIndex = parentPart
  ? (parentPart.content.modules ?? []).findIndex((m) => m.uuid === story.uuid)
  : -1;

const { fetchFormationIndex } = await import('../../lib/storyblok');
const allParts = await fetchFormationIndex();
const partNumber = allParts.findIndex((p) => p.uuid === parentPart?.uuid);

const approche = cleanRichText(story.content.approche);
const resultat = cleanRichText(story.content.resultat);
const temps = cleanRichText(story.content.temps);
const outil = cleanRichText(story.content.outil);
const prerequis = cleanRichText(story.content.prerequis);

const hasContext =
  hasRichText(approche) ||
  hasRichText(resultat) ||
  hasRichText(temps) ||
  hasRichText(outil) ||
  hasRichText(prerequis);
---

<AppLayout title={`${story.content.title} — Pragma Formation`}>
  <main class="content-shell">
    <p class="eyebrow">MODULE {moduleIndex >= 0 ? moduleIndex + 1 : ''}</p><h1>
      {story.content.title}
    </h1>
    <Breadcrumb
      items={[
        ...(parentPart
          ? [
              {
                label: parentPart.content.title,
                href: `/parties/${parentPart.slug}`,
                level: 'PARTIE',
                number: partNumber,
              },
            ]
          : []),
        {
          label: story.content.title,
          level: 'MODULE',
          number: moduleIndex >= 0 ? moduleIndex + 1 : null,
        },
      ]}
    />
    {
      hasContext && (
        <section class="module-context" aria-label="Contexte du module">
          {hasRichText(approche) && (
            <div class="module-context-lede">
              <p class="eyebrow">Approche</p>
              <div class="rich-text module-context-rich module-context-rich--lede">
                <RichText document={approche} />
              </div>
            </div>
          )}
          {(hasRichText(resultat) || hasRichText(prerequis)) && (
            <div class="module-context-grid">
              {hasRichText(resultat) && (
                <div class="module-context-block">
                  <p class="eyebrow">Résultat</p>
                  <div class="rich-text module-context-rich">
                    <RichText document={resultat} />
                  </div>
                </div>
              )}
              {hasRichText(prerequis) && (
                <div class="module-context-block">
                  <p class="eyebrow">Prérequis</p>
                  <div class="rich-text module-context-rich">
                    <RichText document={prerequis} />
                  </div>
                </div>
              )}
            </div>
          )}
          {(hasRichText(temps) || hasRichText(outil)) && (
            <div class="module-context-meta">
              {hasRichText(temps) && (
                <div class="module-context-block module-context-block--meta">
                  <p class="eyebrow">Temps</p>
                  <div class="rich-text module-context-rich">
                    <RichText document={temps} />
                  </div>
                </div>
              )}
              {hasRichText(outil) && (
                <div class="module-context-block module-context-block--meta">
                  <p class="eyebrow">Outil</p>
                  <div class="rich-text module-context-rich">
                    <RichText document={outil} />
                  </div>
                </div>
              )}
            </div>
          )}
        </section>
      )
    }
    {
      ((story.content.body as SectionText[]) ?? []).map((section) => (
        <div class="section-text">
          {section.titre && <h2>{section.titre}</h2>}
          {section.corps && (
            <div class="rich-text">
              <RichText document={section.corps} />
            </div>
          )}
          {section.bouton_text && section.bouton_lien?.url && (
            <a class="button" href={section.bouton_lien.url}>
              {section.bouton_text}
            </a>
          )}
        </div>
      ))
    }
    <ul class="content-list">
      {
        (story.content.cours ?? [])
          .filter((c) => c.content)
          .filter((c) => !inscription || hasCourseAccess(c, inscription))
          .map((course, courseIndex) => (
            <li>
              <a href={`/cours/${course.slug}`}>
                <>
                  <span>{course.content.title}</span>
                  <ProgressBadge validated={validatedIds.has(course.uuid)} />
                </>
              </a>
            </li>
          ))
      }
    </ul>
  </main>
</AppLayout>
