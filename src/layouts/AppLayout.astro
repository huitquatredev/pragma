---
import Layout from './Layout.astro';
interface Props {
  title: string;
}
const { title } = Astro.props;
---

<Layout seo={{ title, description: 'Pragma Formation' }}>
  <header class="app-header">
    <a href="/dashboard" class="wordmark">PRAGMA / FORMATION</a>
    <form method="post" action="/auth/logout">
      <button type="submit" class="button button--text">Se déconnecter</button>
    </form>
  </header>
  <slot />
  <script>
    // Form interactivity (cours + livrable pages): bundled once, enhances
    // every `form.livrable-form` via DOM + data-attrs.
    import '../scripts/livrable-forms.ts';
  </script>
</Layout>
