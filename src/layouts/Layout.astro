---
/// <reference types="astro/client" />
import Head from './Head.astro';
import Footer from './Footer.astro';
import SkipLink from './SkipLink.astro';
import '../styles/global.css';

interface Props {
  seo?: object;
}

const { seo } = Astro.props;
---

<!doctype html>
<html lang="fr">
  <head>
    <Head {seo} />
  </head>
  <body>
    <SkipLink />

    <main>
      <slot />
      <div class="min-h-[300vh] bg-slate-50"></div>
    </main>

    <Footer />

    <script>
      // Make GSAP and ScrollTrigger available globally on client-side
      import('gsap').then((gsapModule) => {
        const gsap = gsapModule.default || gsapModule;
        import('gsap/ScrollTrigger').then((scrollTriggerModule) => {
          const ScrollTrigger = scrollTriggerModule.default || scrollTriggerModule;
          gsap.registerPlugin(ScrollTrigger);
          window.gsap = gsap;
          window.ScrollTrigger = ScrollTrigger;
        });
      });
    </script>
  </body>
</html>
