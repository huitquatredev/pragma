---
import Analytics from '@vercel/analytics/astro';

const { seo } = Astro.props;

// Guard against undefined seo
const safeSeo = seo || {
  title: '',
  description: '',
  robots: 'all',
  schema: null,
  ogImage: null,
  ogImageAlt: '',
  canonical: null,
};

const canonicalHref = (() => {
  const base = Astro.site ?? Astro.url;
  try {
    return safeSeo.canonical
      ? new URL(safeSeo.canonical, base).href
      : new URL(Astro.url.pathname, base).href;
  } catch {
    return Astro.url.href;
  }
})();
---

<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />

  {safeSeo.title && <title>{safeSeo.title}</title>}

  {safeSeo.themeColor && <meta name="theme-color" content={safeSeo.themeColor} />}

  <meta name="generator" content={Astro.generator} />

  <link rel="canonical" href={canonicalHref} />

  {safeSeo.description && <meta name="description" content={safeSeo.description} />}

  {safeSeo.robots && <meta name="robots" content={safeSeo.robots} />}

  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="shortcut icon" href="/favicon.ico" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700;800&display=swap"
    rel="stylesheet"
  />
  <meta name="apple-mobile-web-app-title" content={import.meta.env.SITE_NAME} />

  {safeSeo.title && <meta property="og:title" content={safeSeo.title} />}
  <meta property="og:type" content="website" />
  {safeSeo.ogImage && <meta property="og:image" content={safeSeo.ogImage} />}
  <meta property="og:url" content={Astro.url.href} />

  {safeSeo.description && <meta property="og:description" content={safeSeo.description} />}
  <meta property="og:locale" content="fr_FR" />
  <meta property="og:site_name" content={import.meta.env.SITE_NAME || 'Pragma'} />
  {safeSeo.ogImageAlt && <meta property="og:image:alt" content={safeSeo.ogImageAlt} />}

  <meta name="twitter:dnt" content="on" />

  {safeSeo.schema && <script type="application/ld+json" set:html={safeSeo.schema} />}

  <slot />
  <Analytics />
</head>
